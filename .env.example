# Copy to .env for local development. Never commit actual secrets.
# Use test/sandbox resources only.

# Supabase development project
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# QuickBooks Online Sandbox / OAuth 2.0
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_REALM_ID=

# Private integration API called by n8n
FINANCE_API_URL=
FINANCE_API_TOKEN=

# n8n local instance (do not store credentials in exported workflow JSON)
N8N_WEBHOOK_BASE_URL=
